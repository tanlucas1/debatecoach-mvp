# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Deepgram (speech to text and AI voice)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# ElevenLabs (optional, more natural AI voices; falls back to Deepgram when the credit runs out)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3_conversational

# Model selected when a round opens (students can still switch)
DEFAULT_PROVIDER=gemini

# Model that writes the feedback sheet, so grading stays consistent whichever model debates
GRADING_PROVIDER=gemini

# Target length of each AI speech, in words. Replies usually land about 20% longer
AI_TURN_WORDS_JC=100
AI_TURN_WORDS_SECONDARY=75

# Who speaks the AI replies: "anam" (default), "aitwin" or "tavus" (avatars), or "voice" for no avatar
AVATAR_PROVIDER=anam

# Anam avatar (Milestone 2). The avatar id comes from Anam Lab. The voice defaults to Cole
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# AI Twin avatar (Milestone 2). The twin id is a sample twin's slug from aitwin.me,
# or the 64-character id of a custom face built from a photo
AITWIN_ID=
AITWIN_SECRET=
AITWIN_TWIN_ID=
# Optional voice as engine:voice. Custom faces default to the standard voice visemetts:rex
AITWIN_VOICE=

# Tavus avatar (Milestone 2). The PAL must use pipeline_mode "echo"
TAVUS_API_KEY=
TAVUS_PAL_ID=
